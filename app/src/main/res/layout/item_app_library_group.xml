<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:id="@+id/folderCard"
            android:layout_width="match_parent"
            android:layout_height="166dp"
            android:background="@drawable/bg_app_library_folder"
            android:clipToOutline="true"
            android:padding="12dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2">

                <ImageView
                    android:id="@+id/previewIcon1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:contentDescription="@null"
                    android:padding="0dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/previewIcon2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:contentDescription="@null"
                    android:padding="0dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/previewIcon3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:contentDescription="@null"
                    android:padding="0dp"
                    android:scaleType="fitCenter" />

                <FrameLayout
                    android:id="@+id/previewSlot4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp">

                    <ImageView
                        android:id="@+id/previewIcon4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="0dp"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:id="@+id/overflowPreviewCluster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/overflowIcon1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_margin="1dp"
                                android:layout_weight="1"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter" />

                            <ImageView
                                android:id="@+id/overflowIcon2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_margin="1dp"
                                android:layout_weight="1"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/overflowIcon3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_margin="1dp"
                                android:layout_weight="1"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter" />

                            <ImageView
                                android:id="@+id/overflowIcon4"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_margin="1dp"
                                android:layout_weight="1"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </GridLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/categoryLabel"
            style="@style/IOSLauncherTextAppLabel"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/ios_workspace_text"
            android:textSize="14sp"
            android:shadowColor="#A0000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>
</layout>
