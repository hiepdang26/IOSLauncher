<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/dockIconRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:padding="8dp">

        <com.vhmsoft.launcherios26.ui.launcher.workspace.AndroidLiquidGlassLayout
            android:id="@+id/iconPlate"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="0dp">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <GridLayout
                android:id="@+id/folderPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alignmentMode="alignMargins"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="3"
                android:padding="7dp"
                android:rowCount="3"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/folderIcon1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/folderIcon2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/folderIcon3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/folderIcon4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/folderIcon5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/folderIcon6"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/folderIcon7"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/folderIcon8"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/folderIcon9"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </GridLayout>

            <com.vhmsoft.launcherios26.ui.launcher.workspace.AndroidLiquidGlassLayout
                android:id="@+id/removeBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_edit_remove_badge"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:translationX="0dp"
                android:translationY="0dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_minus_18" />
            </com.vhmsoft.launcherios26.ui.launcher.workspace.AndroidLiquidGlassLayout>
        </com.vhmsoft.launcherios26.ui.launcher.workspace.AndroidLiquidGlassLayout>
    </FrameLayout>
