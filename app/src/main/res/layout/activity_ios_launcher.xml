<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:launcher="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />

        <variable
            name="state"
            type="com.vhmsoft.launcherios26.ui.launcher.LauncherUiState" />

        <variable
            name="presenter"
            type="com.vhmsoft.launcherios26.ui.launcher.IOSLauncherContract.Presenter" />
    </data>

    <com.vhmsoft.launcherios26.launcher6.LauncherRootView
        android:id="@+id/launcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/settings_background"
        android:contentDescription="@{@string/launcher_installed_apps_count_a11y(state.appCount.get())}"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="@{state.launcherMode.get() ? View.GONE : View.VISIBLE}">

            <FrameLayout
                android:id="@+id/headerScene"
                android:layout_width="match_parent"
                android:layout_height="222dp"
                android:background="@drawable/bg_header_scene"
                android:clipChildren="false"
                android:clipToPadding="false">

                <FrameLayout
                    android:layout_width="118dp"
                    android:layout_height="136dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_notebook"
                    android:rotation="8" />

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="150dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_phone_body"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:rotation="-5">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_phone_screen"
                        android:padding="7dp">

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:columnCount="4"
                            android:rowCount="4">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_lock" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_control" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_blur" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_weather" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_motion" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_change" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_library" />
                        </GridLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_phone_dock"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp">

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_control" />

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_blur" />

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_change" />
                        </LinearLayout>
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="174dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_header_card"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.18"
                            android:text="@{state.title.get()}"
                            android:textColor="@color/settings_header_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="@string/launcher_brand_subtitle"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_header_card_footer" />
                </FrameLayout>

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="24dp"
                    android:contentDescription="@string/settings_action_menu"
                    android:padding="4dp"
                    android:src="@drawable/ic_menu_24" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_like"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_like"
                            android:src="@drawable/ic_thumb_up_24" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_mail"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_mail"
                            android:src="@drawable/ic_mail_24" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_share"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_share"
                            android:src="@drawable/ic_share_24" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="32dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_lock}"
                            app:iconDrawable="@{@drawable/ic_lock_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_lock_screen}" />

                        <include
                            android:id="@+id/makeDefaultLauncherRow"
                            layout="@layout/view_launcher_setting_row"
                            app:clickListener="@{(view) -> presenter.onSetDefaultLauncherClicked()}"
                            app:iconColor="@{@color/settings_fab}"
                            app:iconDrawable="@{@drawable/ic_star_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_make_default_launcher}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_control}"
                            app:iconDrawable="@{@drawable/ic_toggles_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_control_center}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_assistive}"
                            app:iconDrawable="@{@drawable/ic_assistive_24}"
                            app:showDivider="@{false}"
                            app:title="@{@string/settings_assistive_touch}" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_layout}"
                            app:iconDrawable="@{@drawable/ic_grid_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_layout}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_weather}"
                            app:iconDrawable="@{@drawable/ic_weather_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_weather}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_liquid}"
                            app:iconDrawable="@{@drawable/ic_drop_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_liquid_glass}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_blur}"
                            app:iconDrawable="@{@drawable/ic_dots_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_blur_effect}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_motion}"
                            app:iconDrawable="@{@drawable/ic_moon_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_motion_wallpaper}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_wallpaper}"
                            app:iconDrawable="@{@drawable/ic_wallpaper_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_wallpaper}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_change}"
                            app:iconDrawable="@{@drawable/ic_icon_change_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_change_icon}" />

                        <include
                            layout="@layout/view_launcher_setting_row"
                            app:iconColor="@{@color/icon_rename}"
                            app:iconDrawable="@{@drawable/ic_library_24}"
                            app:showDivider="@{true}"
                            app:title="@{@string/settings_rename}" />

                        <include
                            android:id="@+id/appLibraryRow"
                            layout="@layout/view_launcher_setting_row"
                            app:clickListener="@{(view) -> presenter.onAppLibraryClicked()}"
                            app:iconColor="@{@color/icon_library}"
                            app:iconDrawable="@{@drawable/ic_library_24}"
                            app:showDivider="@{false}"
                            app:title="@{@string/settings_app_library}" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="192dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_fab_star"
            android:clickable="true"
            android:focusable="true"
            android:onClick="@{() -> presenter.onSetDefaultLauncherClicked()}"
            android:elevation="8dp"
            android:visibility="@{state.launcherMode.get() ? View.GONE : View.VISIBLE}">

            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_action_featured"
                android:src="@drawable/ic_star_24" />
        </FrameLayout>

        <include
            android:id="@+id/workspace"
            layout="@layout/view_ios_workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="@{state.launcherMode.get() ? View.VISIBLE : View.GONE}"
            app:state="@{state}" />
    </com.vhmsoft.launcherios26.launcher6.LauncherRootView>
</layout>
