<?xml version="1.0" encoding="utf-8"?>
<com.vhmsoft.launcherios26.launcher6.LauncherRootView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:launcher="http://schemas.android.com/apk/res-auto"
        android:id="@+id/launcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/settings_background"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <FrameLayout
                android:id="@+id/headerScene"
                android:layout_width="match_parent"
                android:layout_height="222dp"
                android:background="@drawable/bg_header_scene"
                android:clipChildren="false"
                android:clipToPadding="false">

                <FrameLayout
                    android:layout_width="118dp"
                    android:layout_height="136dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_notebook"
                    android:rotation="8" />

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="150dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_phone_body"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:rotation="-5">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_phone_screen"
                        android:padding="7dp">

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:columnCount="4"
                            android:rowCount="4">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_lock" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_control" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_blur" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_weather" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_motion" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_change" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_library" />
                        </GridLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_phone_dock"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp">

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_control" />

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_blur" />

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_change" />
                        </LinearLayout>
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="174dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_header_card"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.18"
                            android:text="@string/launcher_brand_title"
                            android:textColor="@color/settings_header_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="@string/launcher_brand_subtitle"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_header_card_footer" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/settingsMenuButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:contentDescription="@string/settings_action_menu"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_menu_24" />

                <LinearLayout
                    android:id="@+id/settingsSocialBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="14dp"
                    android:elevation="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:translationZ="12dp">

                    <FrameLayout
                        android:id="@+id/likeButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_like"
                        android:clickable="true"
                        android:contentDescription="@string/settings_action_like"
                        android:elevation="12dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:translationZ="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_like"
                            android:src="@drawable/ic_thumb_up_24" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/mailButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_mail"
                        android:clickable="true"
                        android:contentDescription="@string/settings_action_mail"
                        android:elevation="12dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:translationZ="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_mail"
                            android:src="@drawable/ic_mail_24" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/shareButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_share"
                        android:clickable="true"
                        android:contentDescription="@string/settings_action_share"
                        android:elevation="12dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:translationZ="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_share"
                            android:src="@drawable/ic_share_24" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="30dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:id="@+id/settingsTopCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/lockScreenRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/controlCenterRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/assistiveTouchRow"
                            layout="@layout/view_launcher_setting_row" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/settingsMainCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/layoutRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/weatherRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/liquidGlassRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/blurEffectRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/motionWallpaperRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/wallpaperRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/changeIconRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/renameRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/appLibraryRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/hiddenAppsRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/notificationsRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/makeDefaultLauncherRow"
                            layout="@layout/view_launcher_setting_row" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/settingsBottomCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/rateRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/moreAppsRow"
                            layout="@layout/view_launcher_setting_row" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSettingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/settings_background"
            android:elevation="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/layoutSettingsToolbar"
                android:layout_width="match_parent"
                android:layout_height="106dp"
                android:background="@color/settings_card"
                android:paddingTop="36dp">

                <TextView
                    android:id="@+id/layoutBackButton"
                    style="@style/IOSLauncherTextListLabel"
                    android:layout_width="112dp"
                    android:layout_height="56dp"
                    android:layout_gravity="start|bottom"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:text="@string/layout_back_settings"
                    android:textColor="@color/layout_ios_blue"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/layoutTitle"
                    style="@style/IOSLauncherTextAppLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:gravity="center"
                    android:text="@string/settings_layout"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="18sp" />
            </FrameLayout>

            <ScrollView
                android:id="@+id/layoutSettingsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/layoutSettingsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/layoutTopSpacer"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@color/settings_background" />

                    <LinearLayout
                        android:id="@+id/layoutOptionsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/settings_card"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/darkModeRow"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="17dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/darkModeTitle"
                                style="@style/IOSLauncherTextListLabel"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:text="@string/layout_dark_mode"
                                android:textColor="@color/launcher_text_secondary"
                                android:textSize="14sp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/darkModeSwitch"
                                android:layout_width="58dp"
                                android:layout_height="42dp"
                                android:showText="false" />
                        </LinearLayout>

                        <View
                            android:id="@+id/layoutDivider1"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/settings_divider" />

                        <LinearLayout
                            android:id="@+id/iphone8Row"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="17dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/iphone8Title"
                                style="@style/IOSLauncherTextListLabel"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:text="@string/layout_iphone8_style"
                                android:textColor="@color/launcher_text_secondary"
                                android:textSize="14sp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/iphone8Switch"
                                android:layout_width="58dp"
                                android:layout_height="42dp"
                                android:showText="false" />
                        </LinearLayout>

                        <View
                            android:id="@+id/layoutDivider2"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/settings_divider" />

                        <LinearLayout
                            android:id="@+id/bottomSpacingRow"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="17dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/bottomSpacingTitle"
                                style="@style/IOSLauncherTextListLabel"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:text="@string/layout_bottom_spacing"
                                android:textColor="@color/launcher_text_secondary"
                                android:textSize="14sp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/bottomSpacingSwitch"
                                android:layout_width="58dp"
                                android:layout_height="42dp"
                                android:showText="false" />
                        </LinearLayout>

                        <View
                            android:id="@+id/layoutDivider3"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/settings_divider" />

                        <LinearLayout
                            android:id="@+id/autoArrangeRow"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="17dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/autoArrangeTitle"
                                style="@style/IOSLauncherTextListLabel"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:text="@string/layout_auto_arrange"
                                android:textColor="@color/launcher_text_secondary"
                                android:textSize="14sp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/autoArrangeSwitch"
                                android:layout_width="58dp"
                                android:layout_height="42dp"
                                android:showText="false" />
                        </LinearLayout>

                        <View
                            android:id="@+id/layoutDivider4"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/settings_divider" />

                        <TextView
                            android:id="@+id/hideNavigationTitle"
                            style="@style/IOSLauncherTextListLabel"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center_vertical"
                            android:paddingStart="17dp"
                            android:paddingEnd="16dp"
                            android:text="@string/layout_hide_navigation"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/iconSizeHeader"
                        style="@style/IOSLauncherTextListLabel"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="bottom|start"
                        android:paddingStart="17dp"
                        android:paddingBottom="4dp"
                        android:text="@string/layout_icon_size"
                        android:textAllCaps="true"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/iconSizePanel"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@color/settings_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="34dp"
                        android:paddingEnd="34dp">

                        <ImageView
                            android:id="@+id/iconSizePreview"
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_phone_preview_66" />

                        <SeekBar
                            android:id="@+id/iconSizeSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="14dp"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="@color/layout_ios_blue"
                            android:thumbTint="@color/settings_card" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/homeGridHeader"
                        style="@style/IOSLauncherTextListLabel"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="bottom|start"
                        android:paddingStart="17dp"
                        android:paddingBottom="4dp"
                        android:text="@string/layout_home_grid"
                        android:textAllCaps="true"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/homeGridPanel"
                        android:layout_width="match_parent"
                        android:layout_height="116dp"
                        android:background="@color/settings_card"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/grid5x4Option"
                            android:layout_width="110dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/grid5x4Icon"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:gravity="center"
                                android:text="@string/layout_grid_5x4_icon"
                                android:textColor="#8F8F8F"
                                android:textSize="21sp" />

                            <TextView
                                android:id="@+id/grid5x4Label"
                                style="@style/IOSLauncherTextListLabel"
                                android:layout_width="match_parent"
                                android:layout_height="20dp"
                                android:gravity="center"
                                android:text="@string/layout_grid_5x4"
                                android:textColor="@color/launcher_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/grid6x4Option"
                            android:layout_width="110dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="20dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/grid6x4Icon"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:gravity="center"
                                android:text="@string/layout_grid_6x4_icon"
                                android:textColor="#8F8F8F"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/grid6x4Label"
                                style="@style/IOSLauncherTextListLabel"
                                android:layout_width="match_parent"
                                android:layout_height="20dp"
                                android:gravity="center"
                                android:text="@string/layout_grid_6x4"
                                android:textColor="@color/launcher_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/settingsFab"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="192dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_fab_star"
                android:clickable="true"
                android:contentDescription="@string/settings_rate_5_star"
                android:focusable="true"
            android:elevation="8dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_action_featured"
                android:src="@drawable/ic_star_24" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/settingsDrawerOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:elevation="32dp"
            android:focusable="true"
            android:visibility="gone">

            <View
                android:id="@+id/settingsDrawerDim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99000000"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/settingsDrawerPanel"
                android:layout_width="@dimen/settings_drawer_width"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/settings_background"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="154dp"
                    android:background="@drawable/bg_header_scene"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="128dp"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="42dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_phone_body"
                        android:padding="4dp"
                        android:rotation="-4">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_phone_screen"
                            android:padding="6dp">

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="76dp"
                                android:columnCount="4"
                                android:rowCount="4">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_tiny_app_icon" />

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_tiny_app_icon"
                                    android:backgroundTint="@color/icon_lock" />

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_tiny_app_icon"
                                    android:backgroundTint="@color/icon_control" />

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_tiny_app_icon"
                                    android:backgroundTint="@color/icon_change" />
                            </GridLayout>
                        </FrameLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="150dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="72dp"
                        android:background="@drawable/bg_header_card"
                        android:elevation="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:letterSpacing="0.18"
                            android:text="@string/launcher_brand_title"
                            android:textColor="@color/settings_header_text"
                            android:textSize="12sp" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/drawerReloadRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_refresh_32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_reload_launcher"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerPrivacyRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield_32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_privacy_policy"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerGuideRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@color/settings_drawer_highlight"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_circle_32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_user_guide"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerWebsiteRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_web_32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_website"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerAboutRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info_20"
                        android:tint="@color/settings_drawer_icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_about_us"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <include
            android:id="@+id/workspace"
            layout="@layout/view_ios_workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </com.vhmsoft.launcherios26.launcher6.LauncherRootView>
