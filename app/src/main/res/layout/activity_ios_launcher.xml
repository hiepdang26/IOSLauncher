<?xml version="1.0" encoding="utf-8"?>
<com.vhmsoft.launcherios26.launcher6.LauncherRootView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:launcher="http://schemas.android.com/apk/res-auto"
        android:id="@+id/launcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/settings_background"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <FrameLayout
                android:id="@+id/headerScene"
                android:layout_width="match_parent"
                android:layout_height="222dp"
                android:background="@drawable/bg_header_scene"
                android:clipChildren="false"
                android:clipToPadding="false">

                <FrameLayout
                    android:layout_width="118dp"
                    android:layout_height="136dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_notebook"
                    android:rotation="8" />

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="150dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_phone_body"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:rotation="-5">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_phone_screen"
                        android:padding="7dp">

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:columnCount="4"
                            android:rowCount="4">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_lock" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_control" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_blur" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_weather" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_motion" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_change" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_tiny_app_icon"
                                android:backgroundTint="@color/icon_library" />
                        </GridLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_phone_dock"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp">

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_control" />

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_blur" />

                            <View
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/icon_change" />
                        </LinearLayout>
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="174dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_header_card"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.18"
                            android:text="@string/launcher_brand_title"
                            android:textColor="@color/settings_header_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="@string/launcher_brand_subtitle"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_header_card_footer" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/settingsMenuButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:contentDescription="@string/settings_action_menu"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_menu_24" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_like"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_like"
                            android:src="@drawable/ic_thumb_up_24" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_mail"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_mail"
                            android:src="@drawable/ic_mail_24" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_social_button"
                        android:backgroundTint="@color/social_share"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_action_share"
                            android:src="@drawable/ic_share_24" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="30dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/lockScreenRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/controlCenterRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/assistiveTouchRow"
                            layout="@layout/view_launcher_setting_row" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/layoutRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/weatherRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/liquidGlassRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/blurEffectRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/motionWallpaperRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/wallpaperRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/changeIconRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/renameRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/appLibraryRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/hiddenAppsRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/notificationsRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/makeDefaultLauncherRow"
                            layout="@layout/view_launcher_setting_row" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/rateRow"
                            layout="@layout/view_launcher_setting_row" />

                        <include
                            android:id="@+id/moreAppsRow"
                            layout="@layout/view_launcher_setting_row" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/settingsFab"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="192dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_fab_star"
            android:clickable="true"
            android:focusable="true"
            android:elevation="8dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_action_featured"
                android:src="@drawable/ic_star_24" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/settingsDrawerOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:elevation="32dp"
            android:focusable="true"
            android:visibility="gone">

            <View
                android:id="@+id/settingsDrawerDim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99000000"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/settingsDrawerPanel"
                android:layout_width="@dimen/settings_drawer_width"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/settings_background"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="154dp"
                    android:background="@drawable/bg_header_scene"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="128dp"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="42dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_phone_body"
                        android:padding="4dp"
                        android:rotation="-4">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_phone_screen"
                            android:padding="6dp">

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="76dp"
                                android:columnCount="4"
                                android:rowCount="4">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_tiny_app_icon" />

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_tiny_app_icon"
                                    android:backgroundTint="@color/icon_lock" />

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_tiny_app_icon"
                                    android:backgroundTint="@color/icon_control" />

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_tiny_app_icon"
                                    android:backgroundTint="@color/icon_change" />
                            </GridLayout>
                        </FrameLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="150dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="72dp"
                        android:background="@drawable/bg_header_card"
                        android:elevation="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:letterSpacing="0.18"
                            android:text="@string/launcher_brand_title"
                            android:textColor="@color/settings_header_text"
                            android:textSize="12sp" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/drawerReloadRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_refresh_32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_reload_launcher"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerPrivacyRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield_32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_privacy_policy"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerGuideRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@color/settings_drawer_highlight"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_circle_32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_user_guide"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerWebsiteRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_web_32" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_website"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerAboutRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info_20"
                        android:tint="@color/settings_drawer_icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:text="@string/drawer_about_us"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <include
            android:id="@+id/workspace"
            layout="@layout/view_ios_workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </com.vhmsoft.launcherios26.launcher6.LauncherRootView>
