<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rating_dialog"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="32dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ratingAppIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            style="@style/IOSLauncherTextAppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/rating_dialog_title"
            android:textColor="#111111"
            android:textSize="17sp" />

        <TextView
            style="@style/IOSLauncherTextListLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/rating_dialog_message"
            android:textColor="#222222"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/ratingStarRow"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ratingStar1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_24"
                android:tint="@color/rating_star_empty" />

            <ImageView
                android:id="@+id/ratingStar2"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_24"
                android:tint="@color/rating_star_empty" />

            <ImageView
                android:id="@+id/ratingStar3"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_24"
                android:tint="@color/rating_star_empty" />

            <ImageView
                android:id="@+id/ratingStar4"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_24"
                android:tint="@color/rating_star_empty" />

            <ImageView
                android:id="@+id/ratingStar5"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_24"
                android:tint="@color/rating_star_empty" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ratingLaterButton"
                style="@style/IOSLauncherTextAppLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/rating_action_later"
                android:textColor="@color/settings_fab"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ratingNoButton"
                style="@style/IOSLauncherTextAppLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/rating_action_no"
                android:textColor="@color/settings_fab"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ratingSendButton"
                style="@style/IOSLauncherTextAppLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/rating_action_send"
                android:textColor="@color/settings_fab"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
