<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:id="@+id/todayWidgetScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="6dp"
        android:paddingTop="38dp"
        android:paddingEnd="6dp"
        android:paddingBottom="118dp">

        <LinearLayout
            android:id="@+id/todayWidgetContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/todayWidgetEditButton"
        android:layout_width="58dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="118dp"
        android:background="@drawable/bg_edit_mode_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/launcher_widget_edit"
        android:textColor="#111111"
        android:textSize="13sp" />
</FrameLayout>
