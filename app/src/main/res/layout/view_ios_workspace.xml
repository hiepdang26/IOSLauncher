<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/workspaceRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ios_wallpaper"
            android:clipChildren="false"
            android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="78dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/workspacePager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:overScrollMode="never" />

            <FrameLayout
                android:id="@+id/bottomControlSlot"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/searchPill"
                    android:layout_width="104dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ios_search_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/searchPillIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search_18" />

                    <TextView
                        android:id="@+id/searchPillText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/launcher_search_hint"
                        android:textColor="@color/ios_workspace_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pageIndicator"
                    android:layout_width="82dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ios_page_indicator"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone" />
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dockRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:background="@drawable/bg_ios_dock"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/editTopBar"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:elevation="18dp"
            android:paddingStart="32dp"
            android:paddingTop="34dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/editOptionsButton"
                android:layout_width="64dp"
                android:layout_height="34dp"
                android:layout_gravity="start|top"
                android:background="@drawable/bg_edit_mode_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Sửa"
                android:textColor="#111111"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/doneEditButton"
                android:layout_width="66dp"
                android:layout_height="34dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_edit_mode_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Xong"
                android:textColor="#111111"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/editWidgetPrompt"
            android:layout_width="260dp"
            android:layout_height="80dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="76dp"
            android:background="@drawable/bg_edit_widget_prompt"
            android:clickable="true"
            android:elevation="22dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="top|start"
                android:paddingTop="12dp"
                android:text="Thêm tiện ích"
                android:textColor="#111111"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_grid_24" />
        </LinearLayout>

        <View
            android:id="@+id/contextOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ios_context_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/selectedIconPreview"
            android:layout_width="94dp"
            android:layout_height="118dp"
            android:clickable="false"
            android:elevation="22dp"
            android:focusable="false"
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:scaleX="1.08"
            android:scaleY="1.08"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/selectedIconPlate"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:elevation="8dp"
                android:padding="0dp">

                <ImageView
                    android:id="@+id/selectedIconImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/selectedIconLabel"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="top|center_horizontal"
                android:maxLines="2"
                android:textColor="@color/ios_workspace_text"
                android:textSize="12sp"
                android:shadowColor="#A0000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/folderOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#22000000"
            android:clickable="true"
            android:elevation="34dp"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/folderTitle"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_gravity="top"
                android:layout_marginTop="156dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#D8FFFFFF"
                android:textSize="32sp"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <FrameLayout
                android:id="@+id/folderContentPanel"
                android:layout_width="310dp"
                android:layout_height="360dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_launcher_folder_panel"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingTop="22dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/folderRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />
            </FrameLayout>
        </FrameLayout>

        <View
            android:id="@+id/folderDragLeftEdgeGlow"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#88FFFFFF"
            android:elevation="68dp"
            android:visibility="gone" />

        <View
            android:id="@+id/folderDragRightEdgeGlow"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#88FFFFFF"
            android:elevation="68dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/searchOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ios_search_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="44dp"
                android:paddingEnd="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/searchField"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ios_search_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/searchFieldIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search_18" />

                        <EditText
                            android:id="@+id/searchEditText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="@string/launcher_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/ios_workspace_text"
                            android:textColorHint="#B8FFFFFF"
                            android:textCursorDrawable="@null"
                            android:textSize="17sp" />

                        <ImageView
                            android:id="@+id/searchMicIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mic_18" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cancelSearchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/launcher_search_cancel"
                        android:textColor="@color/ios_workspace_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/searchSuggestionsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/launcher_search_suggestions"
                    android:textColor="#D8FFFFFF"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/searchResultsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_search_results"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="10dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="180dp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/librarySearchOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ios_wallpaper"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="84dp"
                android:paddingEnd="24dp">

                <LinearLayout
                    android:id="@+id/librarySearchHeader"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/librarySearchField"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_library_search"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/librarySearchFieldIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search_18" />

                        <EditText
                            android:id="@+id/librarySearchEditText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="@string/settings_app_library"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/ios_workspace_text"
                            android:textColorHint="#B8FFFFFF"
                            android:textCursorDrawable="@null"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cancelLibrarySearchButton"
                        android:layout_width="54dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/launcher_search_cancel"
                        android:textColor="@color/ios_workspace_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="26dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/librarySearchRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingEnd="28dp"
                        android:paddingBottom="180dp" />

                    <LinearLayout
                        android:id="@+id/librarySearchIndex"
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|top"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="4dp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/categoryDetailOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ios_wallpaper"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/categoryDetailContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="270dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/categoryDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/ios_workspace_text"
                    android:textSize="28sp"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoryDetailRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="20dp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widgetSheetOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:clickable="true"
            android:elevation="40dp"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/widgetSheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="108dp"
                android:background="@drawable/bg_widget_sheet"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <View
                    android:layout_width="42dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:background="#C7C7CC" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_widget_search"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search_18" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/launcher_search_hint"
                        android:textColor="#8A8A8E"
                        android:textSize="18sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_widget_blue_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:gravity="center"
                        android:paddingTop="32dp"
                        android:text="Không cho phép vị TRÍ, cấp phép để nhận được thông tin\nthời tiết."
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:text="Thời tiết"
                        android:textColor="#111111"
                        android:textSize="12sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_widget_dark_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="30dp"
                            android:text="84%"
                            android:textColor="@color/white"
                            android:textSize="34sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="-26dp"
                            android:text="Ắc quy"
                            android:textColor="#111111"
                            android:textSize="12sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_library_folder">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="-26dp"
                            android:text="Picture"
                            android:textColor="#111111"
                            android:textSize="12sp" />
                    </FrameLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/widgetAppsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="32dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_library_24" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="Tập tin"
                            android:textColor="#111111"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="62dp"
                        android:background="#D6D6D6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_moon_24" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="Giao diện hệ thống"
                            android:textColor="#111111"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="62dp"
                        android:background="#D6D6D6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_24" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="Cửa hàng Google Play"
                            android:textColor="#111111"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="30dp"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:text="   Tập tin"
                    android:textColor="#111111"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:text="   Giao diện hệ thống"
                    android:textColor="#111111"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:visibility="gone"
                    android:gravity="center_vertical"
