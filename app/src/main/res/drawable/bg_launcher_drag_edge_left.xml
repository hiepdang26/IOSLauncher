<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="11dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>
    <item android:right="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>
    <item android:gravity="top|start">
        <shape android:shape="rectangle">
            <size
                android:width="16dp"
                android:height="3dp" />
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>
    <item android:gravity="bottom|start">
        <shape android:shape="rectangle">
            <size
                android:width="16dp"
                android:height="3dp" />
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>
</layer-list>
