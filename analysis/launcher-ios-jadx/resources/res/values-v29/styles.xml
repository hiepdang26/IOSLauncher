<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SplashTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/background_splash</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="Theme" parent="@style/BaseWallpaperTheme">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:colorControlActivated">@color/launcher_accent_color</item>
        <item name="android:colorPrimary">@color/launcher_accent_color</item>
        <item name="android:colorAccent">@color/launcher_accent_color</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:ambientShadowAlpha">0.1</item>
        <item name="android:spotShadowAlpha">0.5</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="TransparentNavigationStatus" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:listDivider">@null</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLayoutInDisplayCutoutMode">1</item>
        <item name="actionModeShareDrawable">@drawable/ic_share</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="preferenceTheme">@style/PreferenceThemeCustom</item>
    </style>
    <style name="TransparentNavigationStatus_Black" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:listDivider">@null</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">1</item>
        <item name="preferenceTheme">@style/PreferenceThemeCustom</item>
    </style>
</resources>
