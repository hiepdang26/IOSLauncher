<?xml version="1.0" encoding="utf-8"?>
<com.luutinhit.launcher6.allapps.AllAppsContainerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/apps_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    launcher:revealBackground="@drawable/quantum_panel_shape">
    <View
        android:layout_gravity="center"
        android:id="@+id/reveal_view"
        android:focusable="false"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp"/>
    <com.luutinhit.launcher6.allapps.AllAppsRecyclerViewContainerView
        android:layout_gravity="center"
        android:id="@+id/main_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="15dp">
        <com.luutinhit.launcher6.allapps.AllAppsRecyclerView
            android:theme="@style/Theme.Light.CustomOverscroll"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/apps_list_view"
            android:focusable="true"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/all_apps_search_bar_height"/>
        <LinearLayout
            android:layout_gravity="start|top"
            android:orientation="horizontal"
            android:id="@+id/search_container"
            android:background="@drawable/all_apps_search_bg"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/all_apps_search_bar_height">
            <com.luutinhit.launcher6.ExtendedEditText
                android:textSize="16sp"
                android:textColor="#4c4c4c"
                android:textColorHint="#9c9c9c"
                android:gravity="center"
                android:id="@+id/search_box_input"
                android:background="@android:color/transparent"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/container_fastscroll_thumb_max_width"
                android:layout_marginRight="@dimen/container_fastscroll_thumb_max_width"
                android:hint="@string/all_apps_search_bar_hint"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:inputType="textNoSuggestions"
                android:imeOptions="flagNoExtractUi|actionSearch"/>
        </LinearLayout>
    </com.luutinhit.launcher6.allapps.AllAppsRecyclerViewContainerView>
</com.luutinhit.launcher6.allapps.AllAppsContainerView>
