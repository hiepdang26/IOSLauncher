<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgets_full_review_row_view"
    android:focusable="true"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">
    <com.luutinhit.launcher6.widget.WeatherWidget
        android:id="@+id/widget_full_preview_item"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-20dp"
        android:src="@drawable/sample_weather_widget"
        launcher:hideWidgetText="true"
        launcher:isOnHomeWidgetPage="true"
        launcher:layout_constraintDimensionRatio="w, 1:1.6"
        launcher:layout_constraintEnd_toEndOf="parent"
        launcher:layout_constraintStart_toStartOf="parent"
        launcher:layout_constraintTop_toTopOf="parent"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="11sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/widget_full_preview_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        launcher:customFont="semibold"
        launcher:layout_constraintBottom_toBottomOf="@+id/widget_full_preview_item"
        launcher:layout_constraintEnd_toEndOf="parent"
        launcher:layout_constraintStart_toStartOf="parent"/>
    <com.luutinhit.launcher6.leftpage.widgets.BatteryWidget2x2
        android:id="@+id/widget_square_preview_item_1"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        launcher:hideWidgetText="true"
        launcher:isOnHomeWidgetPage="true"
        launcher:layout_constraintDimensionRatio="w, 1:0.9"
        launcher:layout_constraintEnd_toStartOf="@+id/widget_square_preview_item_2"
        launcher:layout_constraintStart_toStartOf="parent"
        launcher:layout_constraintTop_toBottomOf="@+id/widget_full_preview_item"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="11sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/widget_square_preview_text_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        launcher:customFont="semibold"
        launcher:layout_constraintBottom_toBottomOf="@+id/widget_square_preview_item_1"
        launcher:layout_constraintEnd_toEndOf="@+id/widget_square_preview_item_1"
        launcher:layout_constraintStart_toStartOf="@+id/widget_square_preview_item_1"/>
    <com.luutinhit.launcher6.leftpage.widgets.PhotoWidget_2x2
        android:id="@+id/widget_square_preview_item_2"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        launcher:hideWidgetText="true"
        launcher:isOnHomeWidgetPage="true"
        launcher:layout_constraintDimensionRatio="w, 1:0.9"
        launcher:layout_constraintEnd_toEndOf="parent"
        launcher:layout_constraintStart_toEndOf="@+id/widget_square_preview_item_1"
        launcher:layout_constraintTop_toBottomOf="@+id/widget_full_preview_item"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="11sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/widget_square_preview_text_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        launcher:customFont="semibold"
        launcher:layout_constraintBottom_toBottomOf="@+id/widget_square_preview_item_2"
        launcher:layout_constraintEnd_toEndOf="@+id/widget_square_preview_item_2"
        launcher:layout_constraintStart_toStartOf="@+id/widget_square_preview_item_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
