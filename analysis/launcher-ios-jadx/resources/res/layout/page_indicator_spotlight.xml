<?xml version="1.0" encoding="utf-8"?>
<com.luutinhit.launcher6.PageIndicatorSpotlight xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:padding="@dimen/dynamic_grid_page_indicator_margin"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    launcher:windowSize="@integer/config_maxNumberOfPageIndicatorsToShow">
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="11dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/search_spotlight"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/abandoned_search"
        android:drawablePadding="2dp"
        android:alpha="0"
        android:drawableStart="@drawable/ic_search_spotlight"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dynamic_grid_page_indicator_margin"
        android:layout_marginEnd="@dimen/dynamic_grid_page_indicator_margin"/>
</com.luutinhit.launcher6.PageIndicatorSpotlight>
