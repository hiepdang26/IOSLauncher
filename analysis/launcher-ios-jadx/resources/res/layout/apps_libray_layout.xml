<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/apps_child"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/apps_library_layout_scene">
    <FrameLayout
        android:id="@+id/layout_list_apps_library"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.luutinhit.launcher6.util.recyclerviewbouncy.BouncyRecyclerView
            android:id="@+id/list_apps_library"
            android:paddingTop="@dimen/realtime_blur_height_search_view"
            android:paddingBottom="@dimen/search_margin_top"
            android:fitsSystemWindows="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:recyclerview_damping_ratio="DAMPING_RATIO_LOW_BOUNCY"
            app:recyclerview_fling_animation_size="0.8"
            app:recyclerview_overscroll_animation_size="0.8"
            app:recyclerview_stiffness="STIFFNESS_LOW"/>
        <com.luutinhit.launcher6.util.recyclerviewbouncy.BouncyRecyclerView
            android:id="@+id/apps_library_search_view"
            android:paddingTop="@dimen/realtime_blur_height_search_view"
            android:paddingBottom="@dimen/search_margin_top"
            android:visibility="invisible"
            android:fitsSystemWindows="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:recyclerview_damping_ratio="DAMPING_RATIO_LOW_BOUNCY"
            app:recyclerview_fling_animation_size="0.8"
            app:recyclerview_overscroll_animation_size="0.8"
            app:recyclerview_stiffness="STIFFNESS_LOW"/>
    </FrameLayout>
    <com.luutinhit.launcher6.appslibrary.IndexBarView
        android:id="@+id/index_bar_view"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_box_apps_library"/>
    <com.luutinhit.launcher6.util.RealTimeBlurView
        android:id="@+id/realtime_blur_search_box"
        android:layout_width="match_parent"
        android:layout_height="@dimen/realtime_blur_height_search_view"/>
    <com.luutinhit.launcher6.editscreen.CustomViewRound
        android:layout_gravity="start"
        android:id="@+id/search_box_apps_library"
        android:layout_width="0dp"
        android:layout_height="@dimen/search_height"
        android:layout_marginTop="@dimen/search_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.luutinhit.launcher6.ExtendedEditText
        android:textColor="@color/white"
        android:textColorHint="@color/white_50"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/et_search"
        android:background="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:hint="@string/app_library"
        android:maxLines="1"
        android:inputType="text"
        android:textIsSelectable="true"
        android:textCursorDrawable="@null"
        android:drawableStart="@drawable/ic_search"
        app:layout_constraintBottom_toBottomOf="@+id/search_box_apps_library"
        app:layout_constraintEnd_toEndOf="@+id/search_box_apps_library"
        app:layout_constraintStart_toStartOf="@+id/search_box_apps_library"
        app:layout_constraintTop_toTopOf="@+id/search_box_apps_library"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/cancel_button"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@android:string/cancel"
        app:customFont="light"
        app:layout_constraintBottom_toBottomOf="@+id/search_box_apps_library"
        app:layout_constraintStart_toEndOf="@+id/search_box_apps_library"
        app:layout_constraintTop_toTopOf="@+id/search_box_apps_library"
        app:layout_constraintWidth_percent="0.2"/>
</merge>
