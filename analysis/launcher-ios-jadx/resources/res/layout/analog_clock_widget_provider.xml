<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clockContainer"
    android:background="@drawable/clock_face"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/hourHand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hour_hand"
        android:scaleType="center"
        android:pivotX="50%"
        android:pivotY="50%"/>
    <ImageView
        android:id="@+id/minuteHand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/minute_hand"
        android:scaleType="center"
        android:pivotX="50%"
        android:pivotY="50%"/>
    <ImageView
        android:id="@+id/secondHand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/second_hand"
        android:scaleType="center"
        android:pivotX="50%"
        android:pivotY="50%"
        app:tint="@color/red"/>
</FrameLayout>
