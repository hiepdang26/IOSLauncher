<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgets_cell_list_container"
    android:focusable="true"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.luutinhit.launcher6.BubbleTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/section"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:importantForAccessibility="no"
        android:layout_marginStart="20dp"
        launcher:layout_constraintBottom_toBottomOf="parent"
        launcher:layout_constraintStart_toStartOf="parent"
        launcher:layout_constraintTop_toTopOf="parent"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textColor="@color/black"
        android:id="@+id/widget_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginStart="6dp"
        launcher:customFont="semibold"
        launcher:layout_constraintBottom_toBottomOf="parent"
        launcher:layout_constraintEnd_toEndOf="parent"
        launcher:layout_constraintStart_toEndOf="@+id/section"
        launcher:layout_constraintTop_toTopOf="parent"/>
    <HorizontalScrollView
        android:id="@+id/widgets_scroll_container"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        launcher:layout_constraintStart_toStartOf="@+id/section"
        launcher:layout_constraintTop_toBottomOf="@+id/section">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/widgets_cell_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:showDividers="middle"
            android:layout_marginStart="@dimen/widget_row_padding"
            android:layout_marginEnd="@dimen/widget_row_padding"/>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
