<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_weather_layout"
    android:background="@drawable/weather_background_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_padding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:layout_weight="1"
        android:paddingStart="@dimen/widget_padding"
        android:paddingEnd="@dimen/widget_padding">
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="35sp"
                android:textColor="@color/white"
                android:gravity="top"
                android:id="@+id/widget_weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_low_high_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/widget_padding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:layout_weight="1"
        android:paddingStart="@dimen/widget_padding"
        android:paddingEnd="@dimen/widget_padding">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white_68"
                android:id="@+id/widget_weather_item_day_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/widget_weather_item_icon_1"
                android:layout_width="23dp"
                android:layout_height="23dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_item_temp_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white_68"
                android:id="@+id/widget_weather_item_day_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/widget_weather_item_icon_2"
                android:layout_width="23dp"
                android:layout_height="23dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_item_temp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white_68"
                android:id="@+id/widget_weather_item_day_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/widget_weather_item_icon_3"
                android:layout_width="23dp"
                android:layout_height="23dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_item_temp_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white_68"
                android:id="@+id/widget_weather_item_day_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/widget_weather_item_icon_4"
                android:layout_width="23dp"
                android:layout_height="23dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_item_temp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white_68"
                android:id="@+id/widget_weather_item_day_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/widget_weather_item_icon_5"
                android:layout_width="23dp"
                android:layout_height="23dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_item_temp_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white_68"
                android:id="@+id/widget_weather_item_day_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/widget_weather_item_icon_6"
                android:layout_width="23dp"
                android:layout_height="23dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/widget_weather_item_temp_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
