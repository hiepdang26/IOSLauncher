<?xml version="1.0" encoding="utf-8"?>
<com.luutinhit.launcher6.editscreen.LinearLayoutRound xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/dialog_root"
    android:padding="20dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:roundRadius="26dp">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Delete app"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="@string/hidden_apps"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="15dp"
        android:id="@+id/btnAction1"
        android:background="@drawable/dialog_rounded_button_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/hidden_apps"
        android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="15dp"
        android:textColor="@color/red"
        android:id="@+id/btnAction2"
        android:background="@drawable/dialog_rounded_button_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/delete_target_uninstall_label"
        android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="15dp"
        android:id="@+id/btnCancel"
        android:background="@drawable/dialog_rounded_button_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle"/>
</com.luutinhit.launcher6.editscreen.LinearLayoutRound>
