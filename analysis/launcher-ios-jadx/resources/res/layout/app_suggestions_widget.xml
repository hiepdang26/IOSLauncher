<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <com.luutinhit.launcher6.editscreen.RecyclerViewRound
        android:layout_gravity="center"
        android:id="@+id/app_suggestions_widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="138dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundRadius="@dimen/widget_round_corner"/>
    <com.luutinhit.launcher6.util.DeleteCircleView
        android:id="@+id/icon_delete_widget"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/icon_delete_size"
        android:layout_height="@dimen/icon_delete_size"
        android:src="@drawable/delete_button"
        android:antialias="true"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintStart_toStartOf="@+id/app_suggestions_widget_content"
        app:layout_constraintTop_toTopOf="@+id/app_suggestions_widget_content"/>
</merge>
