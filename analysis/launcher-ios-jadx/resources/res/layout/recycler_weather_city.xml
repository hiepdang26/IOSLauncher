<?xml version="1.0" encoding="utf-8"?>
<com.luutinhit.launcher6.widget.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_out"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp">
    <RelativeLayout
        android:id="@+id/item_visible"
        android:background="#0b9c95"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/local_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:34"
            android:singleLine="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/local_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ningbo"
            android:singleLine="true"
            android:layout_below="@+id/local_time"/>
        <TextView
            android:textSize="32sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/local_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/item_delete"
        android:background="#ff0000"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:text="Delete"
        android:singleLine="true"
        android:textAllCaps="false"/>
</com.luutinhit.launcher6.widget.SwipeMenuLayout>
