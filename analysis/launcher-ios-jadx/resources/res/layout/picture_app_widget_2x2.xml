<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/picture_widget_content"
        android:background="@drawable/widget_shadow_rect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/picture_widget_permission"
        android:background="@drawable/widget_left_page_background_night"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="w, 1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textColor="@color/accent"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/button_request_storage_permission"
            android:background="@drawable/item_button_state"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_storage_permission"/>
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textColor="@color/contact_typeface"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/warning_storage_permission"
            app:customFont="light"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.luutinhit.launcher6.util.DeleteCircleView
        android:id="@+id/icon_delete_widget"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/icon_delete_size"
        android:layout_height="@dimen/icon_delete_size"
        android:src="@drawable/delete_button"
        android:antialias="true"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintStart_toStartOf="@+id/picture_widget_content"
        app:layout_constraintTop_toTopOf="@+id/picture_widget_content"/>
</merge>
