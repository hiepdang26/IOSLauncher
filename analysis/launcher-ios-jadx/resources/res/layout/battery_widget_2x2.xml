<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_battery_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.luutinhit.launcher6.editscreen.LinearLayoutRound
        android:orientation="vertical"
        android:id="@+id/battery_widget_content"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundRadius="@dimen/widget_round_corner">
        <ImageView
            android:id="@+id/widget_battery_progress"
            android:paddingTop="@dimen/widget_padding"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitStart"
            android:layout_weight="1"
            android:paddingStart="@dimen/widget_padding"
            android:paddingEnd="@dimen/widget_padding"/>
        <TextView
            android:textSize="36sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/widget_battery_text"
            android:paddingBottom="@dimen/widget_padding"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="100%"
            android:layout_weight="1"
            android:paddingStart="@dimen/widget_padding"
            android:paddingEnd="@dimen/widget_padding"/>
    </com.luutinhit.launcher6.editscreen.LinearLayoutRound>
    <com.luutinhit.launcher6.util.DeleteCircleView
        android:id="@+id/icon_delete_widget"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/icon_delete_size"
        android:layout_height="@dimen/icon_delete_size"
        android:src="@drawable/delete_button"
        android:antialias="true"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintStart_toStartOf="@+id/battery_widget_content"
        app:layout_constraintTop_toTopOf="@+id/battery_widget_content"/>
</merge>
