<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/activity_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/blurring_view"
        android:background="#ffffff"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_action_bar_height"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_line"
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="@+id/blurring_view"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="16dp"
        android:textColor="@android:color/black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/action_bar_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/layout"
        app:layout_constraintBottom_toBottomOf="@+id/action_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_back"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="16dp"
        android:textColor="@color/action_back_color"
        android:gravity="start|center_vertical"
        android:id="@+id/action_back"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/status_bar_height"
        android:text="@string/settings_button_text"
        android:drawableLeft="@drawable/ic_back"
        android:drawableStart="@drawable/ic_back"
        app:layout_constraintBottom_toTopOf="@+id/divider_line"
        app:layout_constraintEnd_toStartOf="@+id/action_bar_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_dark_mode"
        android:background="@drawable/item_press_state"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="36dp"
        android:onClick="onClick"
        app:layout_constraintTop_toBottomOf="@+id/divider_line">
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:text="@string/dark_mode"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.luutinhit.launcherios.customsettings.SwitchView
            android:id="@+id/dark_mode"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_iphone_8_style"
        android:background="@drawable/item_press_state"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:onClick="onClick"
        app:layout_constraintTop_toBottomOf="@+id/item_dark_mode">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:text="iPhone 8 Style"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.luutinhit.launcherios.customsettings.SwitchView
            android:id="@+id/iphone_8_style"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_padding_bottom"
        android:background="@drawable/item_press_state"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:onClick="onClick"
        app:layout_constraintTop_toBottomOf="@+id/item_iphone_8_style">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:text="@string/padding_bottom"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.luutinhit.launcherios.customsettings.SwitchView
            android:id="@+id/padding_bottom"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_auto_rearrange"
        android:background="@drawable/item_press_state"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:onClick="onClick"
        app:layout_constraintTop_toBottomOf="@+id/item_padding_bottom">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:text="@string/auto_rearrange_apps"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.luutinhit.launcherios.customsettings.SwitchView
            android:id="@+id/auto_rearrange"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_navigation_bar"
        android:background="@drawable/item_press_state"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:onClick="onClick"
        app:layout_constraintTop_toBottomOf="@+id/item_auto_rearrange">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:text="@string/hide_navigation_bar_on_home_screen"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="12sp"
        android:id="@+id/text_icon_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Icon Size"
        android:textAllCaps="true"
        android:layout_marginStart="16dp"
        app:customFont="light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_navigation_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_icon_size"
        android:background="@drawable/item_press_state"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_icon_size">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_size_demo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/call_icon_rounded"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekbar_icon_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:max="20"
            android:progress="10"
            android:progressDrawable="@drawable/seekbar_track"
            android:thumb="@drawable/seekbar_thump"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon_size_demo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="12sp"
        android:id="@+id/text_layout_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Home screen grid"
        android:textAllCaps="true"
        android:layout_marginStart="16dp"
        app:customFont="light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_icon_size"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_screen_grid"
        android:background="@drawable/item_press_state"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_layout_size">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/layout_5x4"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_5x4"
            android:onClick="onClick"
            app:layout_constraintEnd_toStartOf="@+id/layout_6x4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:id="@+id/text_5x4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5x4"
            app:layout_constraintEnd_toEndOf="@+id/layout_5x4"
            app:layout_constraintStart_toStartOf="@+id/layout_5x4"
            app:layout_constraintTop_toBottomOf="@+id/layout_5x4"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/layout_6x4"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_6x4"
            android:onClick="onClick"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/layout_5x4"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:id="@+id/text_6x4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6x4"
            app:layout_constraintEnd_toEndOf="@+id/layout_6x4"
            app:layout_constraintStart_toStartOf="@+id/layout_6x4"
            app:layout_constraintTop_toBottomOf="@+id/layout_6x4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
