<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <ImageView
            android:id="@+id/dialog_set_default_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/dialog_set_default_app_name"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:text="@string/app_name"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/dialog_set_default_title"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:text="@string/change_default_home_dialog_body"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/dialog_set_default_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:animateLayoutChanges="true">
            <Button
                android:textSize="18sp"
                android:textColor="@color/action_back_color"
                android:gravity="center"
                android:id="@+id/dialog_set_default_button_negative"
                android:background="@drawable/ios_button_dialog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-1dp"
                android:text="@android:string/cancel"
                android:layout_weight="1"
                android:layout_marginStart="-1dp"
                android:layout_marginEnd="-1dp"/>
            <Button
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:gravity="center"
                android:id="@+id/dialog_set_default_button_positive"
                android:background="@drawable/ios_button_dialog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-1dp"
                android:text="@android:string/ok"
                android:layout_weight="1"
                android:layout_marginEnd="-1dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
