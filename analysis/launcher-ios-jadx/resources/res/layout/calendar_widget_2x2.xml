<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:animateLayoutChanges="true">
    <com.luutinhit.launcher6.editscreen.LinearLayoutRound
        android:orientation="vertical"
        android:id="@+id/calendar_widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="w, 1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundRadius="@dimen/widget_round_corner">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textSize="10sp"
            android:textColor="@color/red"
            android:ellipsize="end"
            android:id="@+id/calendar_day_in_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/calendar"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textAlignment="viewStart"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textSize="30sp"
            android:textColor="@color/black"
            android:id="@+id/calendar_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="28"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="@+id/calendar_day_in_week"
            app:layout_constraintTop_toBottomOf="@+id/calendar_day_in_week"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/event_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
    </com.luutinhit.launcher6.editscreen.LinearLayoutRound>
    <com.luutinhit.launcher6.editscreen.LinearLayoutRound
        android:orientation="vertical"
        android:id="@+id/calendar_widget_permission"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="w, 1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundRadius="@dimen/widget_round_corner">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textColor="@color/accent"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/button_request_calendar_permission"
            android:background="@drawable/item_button_state"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_calendar_permission"
            app:layout_constraintTop_toBottomOf="@+id/header_widget_layout"/>
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textColor="@color/contact_typeface"
            android:gravity="center"
            android:id="@+id/calendar_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/warning_calendar_permission"
            app:customFont="light"
            app:layout_constraintTop_toBottomOf="@+id/button_request_calendar_permission"/>
    </com.luutinhit.launcher6.editscreen.LinearLayoutRound>
    <com.luutinhit.launcher6.util.DeleteCircleView
        android:id="@+id/icon_delete_widget"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/icon_delete_size"
        android:layout_height="@dimen/icon_delete_size"
        android:src="@drawable/delete_button"
        android:antialias="true"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintStart_toStartOf="@+id/calendar_widget_content"
        app:layout_constraintTop_toTopOf="@+id/calendar_widget_content"/>
</merge>
