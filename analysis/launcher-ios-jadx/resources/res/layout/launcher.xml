<?xml version="1.0" encoding="utf-8"?>
<com.luutinhit.launcher6.LauncherRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.luutinhit.launcher6.DragLayer
        android:id="@+id/drag_layer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.luutinhit.launcher6.BlurWallpaperBackground
            android:id="@+id/blur_wallpaper_background"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:fitsSystemWindows="true"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <com.luutinhit.launcher6.FocusIndicatorView
            android:id="@+id/focus_indicator"
            android:layout_width="52dp"
            android:layout_height="52dp"/>
        <com.luutinhit.launcher6.Workspace
            android:id="@+id/workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:defaultScreen="@integer/config_workspaceDefaultScreen"
            launcher:pageIndicator="@+id/page_indicator"/>
        <include
            android:id="@+id/hotseat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/hotseat"/>
        <include
            android:id="@+id/overview_panel"
            android:visibility="gone"
            layout="@layout/overview_panel"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/page_indicator_spotlight"/>
        <include
            android:id="@+id/widgets_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/widgets_view"/>
        <include
            android:id="@+id/sliding_up_widgets_app_style"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/sliding_up_widgets_app_style"/>
        <include
            android:id="@+id/customize_color_icon_style"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/customize_color_icon_style"/>
        <com.luutinhit.launcher6.util.CustomZoomButton
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ad000000"
            android:gravity="center"
            android:layout_gravity="start|top"
            android:id="@+id/add_widgets"
            android:background="@drawable/ic_add_widget_done_state"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="60dp"
            android:layout_height="28dp"
            android:antialias="true"
            android:scaleType="fitEnd"
            android:text="@string/edit"
            android:scaleX="0"
            android:scaleY="0"
            android:textAlignment="center"
            android:layout_marginStart="30dp"/>
        <com.luutinhit.launcher6.util.CustomZoomButton
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ad000000"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/add_widgets_done"
            android:background="@drawable/ic_add_widget_done_state"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="60dp"
            android:layout_height="28dp"
            android:antialias="true"
            android:scaleType="fitEnd"
            android:text="@string/done"
            android:scaleX="0"
            android:scaleY="0"
            android:textAlignment="center"
            android:layout_marginEnd="30dp"/>
        <com.luutinhit.launcher6.BlurScreenLayout
            android:id="@+id/blur_background"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/stub_expanded_image_anim"
            android:layout="@layout/app_icon_zoom_anim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.luutinhit.launcher6.DragLayer>
    <com.luutinhit.launcherios.searchview.SearchViewLayout
        android:id="@+id/search_view"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        style="@style/SearchViewLayout"/>
</com.luutinhit.launcher6.LauncherRootView>
