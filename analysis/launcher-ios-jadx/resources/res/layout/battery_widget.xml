<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.luutinhit.launcher6.editscreen.LinearLayoutRound
        android:orientation="vertical"
        android:id="@+id/battery_widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:isSquare="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundRadius="@dimen/widget_round_corner">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/header_widget_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            app:layout_constraintTop_toTopOf="parent">
            <com.luutinhit.launcher6.util.RoundedImageView
                android:layout_width="@dimen/small_icon_size"
                android:layout_height="@dimen/small_icon_size"
                android:layout_margin="8dp"
                android:src="@drawable/battery_icon"
                android:contentDescription="@string/battery"/>
            <com.luutinhit.launcher6.util.TextViewCustomFont
                android:textSize="12sp"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/battery"
                android:singleLine="true"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:textAlignment="viewStart"
                app:customFont="light"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_devices"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@+id/header_widget_layout"/>
    </com.luutinhit.launcher6.editscreen.LinearLayoutRound>
    <com.luutinhit.launcher6.util.DeleteCircleView
        android:id="@+id/icon_delete_widget"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/icon_delete_size"
        android:layout_height="@dimen/icon_delete_size"
        android:src="@drawable/delete_button"
        android:antialias="true"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintStart_toStartOf="@+id/battery_widget_content"
        app:layout_constraintTop_toTopOf="@+id/battery_widget_content"/>
</merge>
