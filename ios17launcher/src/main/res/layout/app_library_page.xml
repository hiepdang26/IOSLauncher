<?xml version="1.0" encoding="utf-8"?>
<com.cloudx.ios17.core.customviews.InsettableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingTop="84dp"
        android:paddingEnd="18dp"
        android:paddingBottom="124dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/app_library_search_pill"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/ios17_library_search_background"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_option_app_library"
                    android:textColor="@android:color/white"
                    android:textSize="17sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/app_library_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="@integer/col_count" />
        </LinearLayout>
    </ScrollView>
</com.cloudx.ios17.core.customviews.InsettableFrameLayout>
