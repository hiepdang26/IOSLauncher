<?xml version="1.0" encoding="utf-8"?>
<com.cloudx.ios17.core.customviews.InsettableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/app_library_search_pill"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_app_library_search"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/app_library_search_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search_18" />

            <TextView
                android:id="@+id/app_library_search_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/settings_app_library"
                android:textColor="@color/ios_workspace_text"
                android:textSize="17sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/app_library_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingBottom="10dp">

            <GridLayout
                android:id="@+id/app_library_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="@integer/col_count" />
        </ScrollView>
    </LinearLayout>
</com.cloudx.ios17.core.customviews.InsettableFrameLayout>
