<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.cloudx.ios17.core.customviews.LauncherRealtimeLiquidGlassLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:blurCornerRadius="100dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_widget"
                android:focusableInTouchMode="true"
                android:minHeight="52dp"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <com.cloudx.ios17.core.customviews.BlissInput
                    android:id="@+id/search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/clearSuggestionImageView"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/ic_search_white_alpha_24dp"
                    android:drawablePadding="8dp"
                    android:hint="@string/launcher_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#BFFFFFFF"
                    android:theme="?searchBarTheme" />

                <ImageView
                    android:id="@+id/clearSuggestionImageView"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/voiceSearchImageView"
                    android:padding="2dp"
                    android:src="@drawable/ic_cancel_white_24dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/voiceSearchImageView"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic_18" />
            </RelativeLayout>
        </com.cloudx.ios17.core.customviews.LauncherRealtimeLiquidGlassLayout>

        <TextView
            android:id="@+id/search_cancel_button"
            android:layout_width="58dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/launcher_search_cancel"
            android:textColor="#DDE7F5"
            android:textSize="16sp" />
    </LinearLayout>

    <com.cloudx.ios17.core.customviews.LauncherRealtimeLiquidGlassLayout
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:blurCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/item_widget_round_corner"
            android:orientation="vertical">

            <include
                android:id="@+id/used_apps_layout"
                layout="@layout/layout_used_apps" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/suggestionRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.cloudx.ios17.core.customviews.LauncherRealtimeLiquidGlassLayout>
</LinearLayout>
